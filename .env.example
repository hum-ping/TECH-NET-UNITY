# JARVIS — placeholders only. Put real values in an untracked .env or secret store.
JARVIS_NAME=JARVIS
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=.jarvis

# AI provider (OpenAI-compatible providers can use a custom base URL)
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# Optional voice
JARVIS_VOICE_ENABLED=false
JARVIS_WAKE_WORD=jarvis

# Local computer control: off until deliberately enabled and allowlists reviewed.
JARVIS_COMPUTER_CONTROL=false
JARVIS_REQUIRE_CONFIRMATION=true
JARVIS_ALLOWED_APPS=calculator
JARVIS_ALLOWED_HOSTS=github.com,google.com,calendar.google.com,mail.google.com,drive.google.com

# Trading: paper mode and live execution are independent fail-closed controls.
JARVIS_TRADING_MODE=paper
JARVIS_LIVE_TRADING=false
JARVIS_REQUIRE_TRADE_CONFIRMATION=true
JARVIS_TRADING_KILL_SWITCH=false
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3

JARVIS_TIMEZONE=UTC
JARVIS_DAILY_BRIEF_TIME=08:00

# Broker integration — only configured after reviewing its official API.
DERVE_API_BASE_URL=
DERVE_API_KEY=
DERVE_API_SECRET=
DERVE_ACCOUNT_ID=
