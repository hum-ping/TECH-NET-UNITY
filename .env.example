# JARVIS
JARVIS_MODE=paper
JARVIS_LOG_LEVEL=INFO
JARVIS_NAME=JARVIS
JARVIS_COMPUTER_CONTROL=false
JARVIS_REQUIRE_CONFIRMATION=true
JARVIS_DAILY_BRIEF_TIME=08:00
JARVIS_TIMEZONE=Africa/Nairobi
JARVIS_WAKE_WORD=jarvis

# JARVIS V2 AI brain
# Keep secrets only in .env or your OS secret store; never commit them.
JARVIS_AI_API_KEY=
JARVIS_AI_BASE_URL=https://api.openai.com/v1
JARVIS_AI_MODEL=gpt-5.6-mini

# DervE / broker integration
# Fill these only after confirming the official API details.
DERVE_API_BASE_URL=
DERVE_API_KEY=
DERVE_API_SECRET=
DERVE_ACCOUNT_ID=

# Trading safety
LIVE_TRADING_ENABLED=false
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3
DEFAULT_STOP_LOSS_PCT=0.01
DEFAULT_TAKE_PROFIT_PCT=0.02
